# Environment — never commit secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# LanceDB data — never commit the actual vector store
*.lance/
lancedb/
~/.mcpvectordb/

# CodeGraphContext — per-repo KuzuDB index
.codegraph

# Personal Claude overrides
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# MCPB build output — generated by `mcpb pack`
*.mcpb

# PyInstaller build artifacts (build-windows.ps1 / build-linux.sh)
# build_models/ is the model staging area; build/ is the PyInstaller work directory.
build_models/
build/
*.spec.bak

# macOS
.DS_Store

# CodeGraphContext per-repo KuzuDB graph (large binary, rebuildable)
.codegraphcontext/
